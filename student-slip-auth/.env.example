# ==============================================================================
# SMART QR STUDENT SLIP AUTHENTICATION - ENVIRONMENT CONFIGURATION
# Copy this file to .env and customize for your environment
# ==============================================================================

# Application Info
APP_NAME="Smart QR Student Slip Authentication"
DEBUG=False

# Cryptographic Secrets (CHANGE THESE IN PRODUCTION!)
SECRET_KEY="generate-a-strong-random-secret-key-for-session-cookies"
HMAC_SECRET="generate-a-strong-32-byte-secret-key-for-qr-hmac"

# Session Duration in Seconds (Default: 86400 = 24 hours)
SESSION_MAX_AGE=86400

# Verification Base URL
# Embedded into generated QR code payloads so mobile camera scans navigate directly
# For local development: http://localhost:8000
# For free hosting: https://your-project-name.onrender.com (or your domain)
VERIFY_BASE_URL="http://localhost:8000"

# Database Configuration
# Default: Local persistent SQLite
# For PostgreSQL (Render / Railway / Supabase): postgresql://user:pass@host:5432/dbname
DATABASE_URL="sqlite:///data/slips.db"

# Default Administrator Credentials (Created automatically on first launch)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeThisPassword@2026"

# Rate Limiting (Requests per minute per client IP for scan/verify endpoints)
RATE_LIMIT_PER_MINUTE=120
